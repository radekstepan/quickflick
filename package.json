{
  "name": "quickflick",
  "version": "0.1.0",
  "description": "A local video library browser for macOS",
  "main": "./out/main/index.js",
  "productName": "QuickFlick",
  "author": "Radek Stepan",
  "scripts": {
    "preinstall": "node scripts/check-node.cjs",
    "dev": "node scripts/check-node.cjs && node scripts/rebuild-native.cjs && QFKILL_PARENT=1 electron-vite dev",
    "build": "node scripts/check-node.cjs && node scripts/rebuild-native.cjs && electron-vite build",
    "start": "node scripts/check-node.cjs && node scripts/rebuild-native.cjs && electron-vite preview",
    "preview": "node scripts/check-node.cjs && node scripts/rebuild-native.cjs && electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node scripts/check-node.cjs && node scripts/rebuild-native-node.cjs && vitest run",
    "test:watch": "node scripts/check-node.cjs && node scripts/rebuild-native-node.cjs && vitest",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "package:mac:x64": "npm run build && electron-builder --mac --x64"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.18.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.0"
  },
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.quickflick.app",
    "productName": "QuickFlick",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
